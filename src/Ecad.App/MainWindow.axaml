<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ecad.App.ViewModels"
        xmlns:controls="using:Ecad.App.Controls"
        x:Class="Ecad.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Width="1440" Height="900"
        Background="#0E1522">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open…" InputGesture="Meta+O" Click="OnOpenClick" />
                <MenuItem Header="_Save" InputGesture="Meta+S" Click="OnSaveClick" IsEnabled="{Binding HasBoard}" />
                <MenuItem Header="Save _As…" InputGesture="Meta+Shift+S" Click="OnSaveAsClick" IsEnabled="{Binding HasBoard}" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGesture="Meta+Z" Click="OnUndoClick" IsEnabled="{Binding CanUndo}" />
                <MenuItem Header="_Redo" InputGesture="Meta+Shift+Z" Click="OnRedoClick" IsEnabled="{Binding CanRedo}" />
                <Separator />
                <MenuItem Header="_Move" InputGesture="M" IsEnabled="False" />
                <MenuItem Header="_Rotate" InputGesture="R" Click="OnRotateClick" IsEnabled="{Binding HasBoard}" />
                <MenuItem Header="_Delete" InputGesture="Delete" Click="OnDeleteClick" IsEnabled="{Binding HasBoard}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom to _Fit" InputGesture="Home" Click="OnFitClick" IsEnabled="{Binding HasBoard}" />
                <MenuItem Header="View from _Bottom" ToggleType="CheckBox" IsChecked="{Binding FlipView}" />
                <MenuItem Header="Highlight Selected _Net" ToggleType="CheckBox" IsChecked="{Binding HighlightNet}" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" Background="#121C2C" BorderBrush="#22304A" BorderThickness="0,1,0,0" Padding="10,4">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Classes="status" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Classes="status" Margin="16,0" Text="{Binding SelectionText}" />
                <TextBlock Grid.Column="2" Classes="status" Margin="0,0,16,0" FontFamily="Menlo, Consolas, monospace" Text="{Binding CursorText}" />
                <TextBlock Grid.Column="3" Classes="status" FontFamily="Menlo, Consolas, monospace" Text="{Binding FrameText}" />
            </Grid>
        </Border>

        <Grid ColumnDefinitions="230,4,*,4,300">
            <!-- Layers -->
            <DockPanel Background="#121C2C">
                <TextBlock DockPanel.Dock="Top" Classes="panelHeader" Text="LAYERS" />
                <ListBox ItemsSource="{Binding Layers}" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LayerItemViewModel">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ToolTip.Tip="{Binding Name}">
                                <CheckBox IsChecked="{Binding IsVisible}" MinWidth="0" Padding="0" Margin="0,0,6,0" />
                                <Border Grid.Column="1" Width="14" Height="14" CornerRadius="2" Background="{Binding Brush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="12" />
                                <TextBlock Grid.Column="3" Text="{Binding PrimitiveCount}" VerticalAlignment="Center" FontSize="10" Foreground="#6F819C" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="8,1" />
                            <Setter Property="MinHeight" Value="26" />
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Background="#22304A" ResizeDirection="Columns" />

            <!-- Board -->
            <Panel Grid.Column="2">
                <controls:BoardCanvas x:Name="Canvas"
                                      Editor="{Binding Editor}"
                                      FlipX="{Binding FlipView}"
                                      HighlightNet="{Binding HighlightNet}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasBoard}" Spacing="8">
                    <TextBlock Text="Drop a .kicad_pcb here" FontSize="22" Foreground="#6F819C" HorizontalAlignment="Center" />
                    <TextBlock Text="or use File → Open (⌘O)" Foreground="#4E5F78" HorizontalAlignment="Center" />
                </StackPanel>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" VerticalAlignment="Top" />
            </Panel>

            <GridSplitter Grid.Column="3" Background="#22304A" ResizeDirection="Columns" />

            <!-- Properties -->
            <DockPanel Grid.Column="4" Background="#121C2C">
                <TextBlock DockPanel.Dock="Top" Classes="panelHeader" Text="PROPERTIES" />
                <TextBlock DockPanel.Dock="Top" Margin="10,4" FontSize="12" Foreground="#4E5F78" Text="Click an item on the board"
                           IsVisible="{Binding !Properties.Count}" />
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Properties}" Margin="10,0,10,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PropertyRow">
                                <Grid ColumnDefinitions="100,*" Margin="0,3">
                                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#8FA3BF" />
                                    <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
