<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\core\Anode.Kicad\Anode.Kicad.csproj" />
    <ProjectReference Include="..\..\core\Anode.Geometry\Anode.Geometry.csproj" />
    <!-- The font engine behind outline (TrueType) text: glyph outlines only, nothing is drawn with it here. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <!-- Shaping, as KiCad shapes: kerning and ligatures. The same version Avalonia already ships with the app. -->
    <PackageReference Include="HarfBuzzSharp" Version="8.3.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- KiCad newstroke glyphs, generated by tools/convert-newstroke.py (GPL-2.0-or-later, see THIRD-PARTY-NOTICES.md). -->
    <EmbeddedResource Include="Fonts\newstroke.txt.gz" LogicalName="Anode.Render.Fonts.newstroke.txt.gz" />
  </ItemGroup>

</Project>
